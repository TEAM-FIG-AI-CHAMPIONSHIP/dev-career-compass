# macOS
.DS_Store
**/.DS_Store

# Editors
.idea/
.vscode/

# JavaScript and Next.js
**/node_modules/
**/.next/
**/out/
**/.vercel/
**/coverage/

# Environment variables
**/.env*
!**/.env.example

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.coverage
**/htmlcov/
**/dist/
**/build/

# Pipeline working data and collected source bodies
data/raw/
data/work/
data/intermediate/

# Logs
**/*.log

# 디자인 캔버스 생성물 (편집기 코드가 통째로 들어간 2.5MB 파일)
# 원본은 design/*.dc.html 과 design/canvas.json 입니다.
design/*.html
!design/*.dc.html
